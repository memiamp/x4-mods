<?xml version="1.0" encoding="utf-8"?>
<mdscript name="mp_autoresourceprobe" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd" version="1">
  <cues>
    <cue name="MonitorPlayerShips" instantiate="true">
      <conditions>
        <event_object_changed_sector object="player.entity" />
      </conditions>
      
      <actions>
        <!-- Get the existing probes so we can remove them afterwards -->
        <find_object name="$existingProbes" class="class.resourceprobe" owner="faction.player" space="player.entity.sector" multiple="true"/>

        <!-- Don't add resources to sectors without any resource areas -->
        <do_if value="player.entity.sector.resources.count gt 0">
          <!-- Get probe type -->
          <set_value name="$targetMacro" exact="macro.eq_arg_resourceprobe_01_macro"/>
          
          <!-- Positional parameters -->
          <set_value name="$spacing" exact="75000" />
          
          <set_value name="$corePosition" exact="player.entity.sector.coreposition" />
          <set_value name="$coreRadius" exact="(player.entity.sector.coresize)i / 2" />
          
          <set_value name="$minX" exact="$corePosition.x - $coreRadius - $spacing" />
          <set_value name="$maxX" exact="$corePosition.x + $coreRadius + $spacing" />
          <set_value name="$minZ" exact="$corePosition.z - $coreRadius - $spacing" />
          <set_value name="$maxZ" exact="$corePosition.z + $coreRadius + $spacing" />

          <set_value name="$targetPositions" exact="[]"/>
          
          <!-- Go through points in the sector -->
          <set_value name="$x" exact="$minX" />
          <do_while value="$x lt $maxX">

            <set_value name="$z" exact="$minZ" />
            <do_while value="$z lt $maxZ">
              <set_value name="$searchPosition" exact="position.[$x, 0, $z]"/>
              
              <find_closest_resource refobject="player.entity.sector" ware="player.entity.sector.resources.list" ignoredangerousregions="true" wares="$targetWares" sector="$targetSector" position="$targetPosition">
                <refposition value="$searchPosition"/>
              </find_closest_resource>
              
              <set_value name="$exists" exact="$targetPositions.indexof.{$targetPosition}"/>
              <do_if value="$exists == 0">
                <append_to_list name="$targetPositions" exact="$targetPosition"/>
              </do_if>
  
              <set_value name="$z" exact="$z + $spacing"/>
            </do_while>
            
            <set_value name="$x" exact="$x + $spacing"/>
          </do_while>

          <do_for_each in="$targetPositions" name="$targetPosition">
            <create_object macro="$targetMacro" owner="faction.player" sector="player.entity.sector">
              <position value="$targetPosition"/>
            </create_object>
          </do_for_each>

          <remove_value name="$targetMacro"/>
          <remove_value name="$targetPosition"/>
          <remove_value name="$targetPositions"/>
          <remove_value name="$targetWares"/>
        </do_if>

        <!-- Remove the existing probes -->
        <do_all exact="$existingProbes.count" counter="$i">
          <destroy_object object="$existingProbes.{$i}" explosion="false" />
        </do_all>
        
        <!-- Tidy up -->
        <remove_value name="$existingProbes"/>
      </actions>
    </cue>
  </cues>
</mdscript>